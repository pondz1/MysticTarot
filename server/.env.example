PORT=3001
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://9router.jsd.my.id/v1
OPENAI_MODEL=tarot-cards
# Completion budget (thinking models count reasoning toward this). Defaults: 16000 / 32000
# OPENAI_MAX_TOKENS=16000
# OPENAI_MAX_TOKENS_LONG=32000
JWT_SECRET=your_jwt_secret_key_here

# Admin token for /api/user/refill and /api/user/reset-credits in production (header: x-admin-token)
# ADMIN_TOKEN=change-me-to-a-long-random-string

# Simulated top-up packages: on by default outside production when Omise is NOT set.
# Set true only for staging demos — never enables real payment.
# ENABLE_TOPUP_SIMULATOR=false

# Omise payments (https://dashboard.omise.co)
# Test keys start with pkey_test_ / skey_test_
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxx
OMISE_SECRET_KEY=skey_test_xxxxxxxx
# Optional: public site URL for 3DS return_uri
# PUBLIC_APP_URL=https://your-domain.com

# Omise Dashboard → Webhooks → Webhook secret (Base64).
# Omise sends Omise-Signature + Omise-Signature-Timestamp headers (NOT ?secret=).
# URL should be: https://your-domain.com/api/webhooks/omise
# OMISE_WEBHOOK_SECRET=paste_dashboard_webhook_secret_here
